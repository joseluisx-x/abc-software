{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.example/docs/contracts/SCHEMAS/daily-summary.schema.json",
  "title": "Resumen diario de comprobantes",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "fechaResumen", "estado", "comprobantes"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "fechaResumen": { "type": "string", "format": "date" },
    "estado": { "type": "string", "enum": ["DRAFT", "READY", "SUBMITTED", "PENDING", "ACCEPTED", "OBSERVED", "REJECTED"] },
    "ticket": { "type": "string", "maxLength": 100 },
    "comprobantes": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "creadoEn": { "type": "string", "format": "date-time" },
    "respuestaCodigo": { "type": "string", "maxLength": 20 },
    "respuestaDescripcion": { "type": "string", "maxLength": 1000 }
  }
}
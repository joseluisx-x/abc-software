{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.example/docs/contracts/SCHEMAS/product.schema.json",
  "title": "Producto",
  "type": "object",
  "additionalProperties": false,
  "required": ["sku", "descripcion", "unidadMedida", "precioUnitario", "codigoAfectacionIGV"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "sku": { "type": "string", "minLength": 1, "maxLength": 64 },
    "descripcion": { "type": "string", "minLength": 1, "maxLength": 300 },
    "unidadMedida": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6,
      "description": "Código de unidad de medida; catálogo y perfil UBL aplicables POR VERIFICAR."
    },
    "precioUnitario": { "type": "number", "minimum": 0 },
    "codigoAfectacionIGV": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4,
      "description": "Código de afectación IGV del Catálogo SUNAT 07; vigencia POR VERIFICAR."
    },
    "codigoSistemaISC": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4,
      "description": "Código del sistema ISC del Catálogo SUNAT 08 cuando corresponda; vigencia POR VERIFICAR."
    },
    "sujetoICBPER": { "type": "boolean" },
    "activo": { "type": "boolean", "default": true }
  }
}
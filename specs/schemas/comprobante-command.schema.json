{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.example/specs/schemas/comprobante-command.schema.json",
  "title": "Comando de emisión de comprobante",
  "type": "object",
  "additionalProperties": false,
  "required": ["tipoCpe", "serie", "fechaEmision", "moneda", "cliente", "lineas"],
  "properties": {
    "tipoCpe": {
      "type": "string",
      "enum": ["01", "03", "07", "08"],
      "description": "Código Catálogo SUNAT 01; aplicabilidad y perfil POR VERIFICAR."
    },
    "serie": { "type": "string", "pattern": "^[A-Za-z0-9]{1,4}$" },
    "fechaEmision": { "type": "string", "format": "date" },
    "moneda": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "Código ISO 4217 validado contra Catálogo SUNAT 02."
    },
    "cliente": { "$ref": "cliente.schema.json" },
    "lineas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["descripcion", "cantidad", "unidadMedida", "precioUnitario", "codigoAfectacionIGV"],
        "properties": {
          "productoId": { "type": "string", "format": "uuid" },
          "sku": { "type": "string", "maxLength": 64 },
          "descripcion": { "type": "string", "minLength": 1, "maxLength": 300 },
          "cantidad": { "type": "number", "exclusiveMinimum": 0 },
          "unidadMedida": { "type": "string", "minLength": 1, "maxLength": 6 },
          "precioUnitario": { "type": "number", "minimum": 0 },
          "descuento": { "type": "number", "minimum": 0, "default": 0 },
          "codigoAfectacionIGV": { "type": "string", "minLength": 1, "maxLength": 4 },
          "codigoSistemaISC": { "type": "string", "minLength": 1, "maxLength": 4 },
          "cantidadBolsasICBPER": { "type": "integer", "minimum": 0, "default": 0 }
        }
      }
    },
    "condicionPago": { "type": "string", "maxLength": 100 },
    "documentoReferencia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipoCpe", "serie", "correlativo"],
      "properties": {
        "tipoCpe": { "type": "string", "minLength": 1, "maxLength": 4 },
        "serie": { "type": "string", "minLength": 1, "maxLength": 4 },
        "correlativo": { "type": "string", "minLength": 1, "maxLength": 20 },
        "motivoCodigo": { "type": "string", "minLength": 1, "maxLength": 4 }
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.example/specs/schemas/comprobante-linea.schema.json",
  "title": "Línea calculada de comprobante",
  "type": "object",
  "additionalProperties": false,
  "required": ["numeroLinea", "descripcion", "cantidad", "unidadMedida", "precioUnitario", "valorVenta", "codigoAfectacionIGV", "impuestos"],
  "properties": {
    "numeroLinea": { "type": "integer", "minimum": 1 },
    "productoId": { "type": "string", "format": "uuid" },
    "sku": { "type": "string", "maxLength": 64 },
    "descripcion": { "type": "string", "minLength": 1, "maxLength": 300 },
    "cantidad": { "type": "number", "exclusiveMinimum": 0 },
    "unidadMedida": { "type": "string", "minLength": 1, "maxLength": 6 },
    "precioUnitario": { "type": "number", "minimum": 0 },
    "descuento": { "type": "number", "minimum": 0 },
    "valorVenta": { "type": "number" },
    "codigoAfectacionIGV": { "type": "string", "minLength": 1, "maxLength": 4 },
    "impuestos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codigoTributo", "baseImponible", "importe"],
        "properties": {
          "codigoTributo": { "type": "string", "minLength": 1, "maxLength": 8 },
          "baseImponible": { "type": "number" },
          "tasa": { "type": "number", "minimum": 0 },
          "importe": { "type": "number" }
        }
      }
    }
  }
}